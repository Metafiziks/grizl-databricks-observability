# Copy to grizl.databricks.security.env and fill in real values.
# Do not commit real values — grizl.databricks.security.env is gitignored.
# Variables use `export` so they are available to all subprocesses after `source`.

# ── Databricks workspace ──────────────────────────────────────────────────────
export DATABRICKS_HOST=https://<YOUR_WORKSPACE>.cloud.databricks.com

# Databricks CLI profile (from ~/.databrickscfg or OAuth login)
export DATABRICKS_PROFILE=grizl

# ── IP Access List ────────────────────────────────────────────────────────────
# Label for the ALLOW list created in the workspace.
export DATABRICKS_IP_LIST_LABEL=GRIZL_TRUSTED_POLICY

# Comma-separated list of trusted CIDR blocks.
# Find your current IP:  curl -s https://checkip.amazonaws.com
# Single host:           append /32   e.g. 203.0.113.10/32
# Subnet:                use /24      e.g. 203.0.113.0/24
#
# Note: Databricks IP Access Lists must be enabled on the workspace first.
# Settings → Admin Console → Security → IP Access Lists → Enable
export DATABRICKS_TRUSTED_IPS="<YOUR_IP>/32"
