# Copy to grizl.snowflake.security.env and fill in real values.
# Do not commit real values — grizl.snowflake.security.env is gitignored.
# Variables use `export` so they are available to all subprocesses after `source`.

# ── Snowflake connection ──────────────────────────────────────────────────────
# Profile name from ~/.snowflake/config.toml
export SNOWFLAKE_CONNECTION=grizl-enterprise

# ── Network policy ────────────────────────────────────────────────────────────
# Name for the account-level network policy (will be created or replaced).
export SNOWFLAKE_NETWORK_POLICY_NAME=GRIZL_TRUSTED_POLICY

# Comma-separated list of trusted CIDR blocks.
# Find your current IP:  curl -s https://checkip.amazonaws.com
# Single host:           append /32   e.g. 203.0.113.10/32
# Subnet:                use /24      e.g. 203.0.113.0/24
#
# If CI/CD connects from Snowflake, add those IPs here too, or assign a
# separate policy to the service account via SNOWFLAKE_CICD_POLICY_NAME below.
export SNOWFLAKE_TRUSTED_IPS="<YOUR_IP>/32"

# ── Optional: separate CI/CD policy ──────────────────────────────────────────
# If your CI/CD system uses dynamic IPs (e.g. GitHub Actions), set this to
# create a second policy assigned only to the service account user.
# Leave blank to skip.
export SNOWFLAKE_CICD_POLICY_NAME=
export SNOWFLAKE_CICD_TRUSTED_IPS=
export SNOWFLAKE_CICD_USER=
